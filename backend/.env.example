# Pooled connection: used by the FastAPI app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
# Direct connection: used by Alembic migrations and the seed script.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon Auth: the API verifies the JWTs the frontend forwards (JWKS, EdDSA).
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon Object Storage (S3-compatible). Create a storage-scoped credential on the branch
# (or `neon env pull`); the access key id is the credential's token id.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.<cluster>.<region>.aws.neon.tech
AWS_REGION=ap-southeast-1
STORAGE_BUCKET=uploads

# Telegram bot. When set, the bot starts together with the API and answers
# with read-only queries against the same database.
TELEGRAM_BOT_TOKEN=
