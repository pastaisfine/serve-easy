# Base URL of the FastAPI backend. Server-side only (no NEXT_PUBLIC_ prefix).
# Defaults to http://localhost:8000 when unset.
SERVE_API_URL=http://localhost:8000

# Neon Auth (Managed Better Auth). Server-side only.
# Auth URL of the Neon branch (Console > Auth > Configuration, or `neon neon-auth status`).
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# Signs the cached-session cookie. 32+ characters: `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=

# Hostname (no scheme) of the Neon Object Storage endpoint that serves uploaded photos.
# It is AWS_ENDPOINT_URL_S3 from the backend, without "https://". next/image only
# loads uploads from this host.
STORAGE_PUBLIC_HOST=br-xxx.storage.<cluster>.<region>.aws.neon.tech
